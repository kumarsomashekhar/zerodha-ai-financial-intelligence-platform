# Copy this file to backend/.env and fill in your own values. Never commit backend/.env.

# Zerodha Kite Connect app credentials. Needed only for the LIVE portfolio. Local use only.
KITE_API_KEY=
KITE_API_SECRET=

# GNews key. Used only by the news download scripts.
GNEWS_API_KEY=

# AI explanations through Gemini. Optional: without a key the app shows a safe template instead.
GEMINI_API_KEY=
# Name of the Gemini model to use. Google retires model names over time, so update this if the AI stops answering.
GEMINI_MODEL=gemini-3.5-flash-lite

# Demo mode: set to true on any public server. It hides the LIVE portfolio and refuses every Zerodha route.
DEMO_MODE=false

# Website addresses allowed to call the backend, separated by commas, with no trailing slash.
ALLOWED_ORIGINS=http://localhost:3000

# Analysis and AI requests allowed per visitor per minute (0 switches the limit off).
RATE_LIMIT_PER_MINUTE=20

# Reviewer key, needed to record compliance reviews.
# Leave empty on your own laptop (reviews are allowed). On a public server, set a long random value:
# reviews are refused there while it is empty.
REVIEW_KEY=